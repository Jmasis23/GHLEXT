{
  "manifest_version": 3,
  "name": "GHL Tab Renamer",
  "version": "2.0.0",
  "description": "Rename GoHighLevel tabs dynamically, organize clients, take per-client notes, and switch accounts instantly \u2014 fully redesigned.",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GHL Tab Renamer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-notes": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "Toggle the per-client notepad for the current tab"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "MacCtrl+Shift+K"
      },
      "description": "Open the command palette 2014 search clients, sections, and commands"
    }
  }
}
